# Server-only Gemini credential. Never prefix this with VITE_ or commit its value.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Firebase web configuration. These values are embedded in the browser bundle by Vite;
# restrict the API key in Google Cloud/Firebase to the required APIs and hosted domains.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
